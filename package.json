{
  "name": "test-automation-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "QE CoE — Intelligent Test Automation Accelerator monorepo",
  "workspaces": [
    "qe-playground/server",
    "qe-playground/client",
    "test-accelerator"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:app": "npm run dev --workspace=qe-playground/server & npm run dev --workspace=qe-playground/client",
    "test": "npm test --workspace=test-accelerator",
    "test:headed": "npm run test:headed --workspace=test-accelerator",
    "test:ui": "npm run test:ui --workspace=test-accelerator",
    "test:api-only": "npm run test:api-only --workspace=test-accelerator",
    "lint": "npm run lint --workspace=test-accelerator",
    "report": "npm run report --workspace=test-accelerator"
  },
  "engines": {
    "node": ">=22"
  }
}
